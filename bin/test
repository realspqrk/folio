#!/bin/bash
set -euo pipefail

# Arguments go to ctest, so `bin/test -V` shows every Qt test function as it runs.
root="$(cd "$(dirname "$0")/.." && pwd)"
"$root/bin/build"
QT_QPA_PLATFORM=offscreen ctest --test-dir "$root/build" --output-on-failure --no-tests=error "$@"

# The fork's end to end test: the real app offscreen, driven through the
# bookmarks bar (tests/fork/e2e).
"$root/tests/fork/e2e/run.sh" "$root/tests/fork/e2e/e2e.steps" "$root/build/e2e-out"
